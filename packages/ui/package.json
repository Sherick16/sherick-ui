{
  "name": "sherick-ui",
  "version": "2.0.0-alpha.1",
  "description": "A reusable React component library inspired by Material 3 Expressive.",
  "keywords": [
    "react",
    "ui",
    "components",
    "material",
    "design"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "style": "dist/styles.css",
  "type": "module",
  "author": "Sherick Eksteen",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./content": {
      "types": "./dist/types/content.d.ts",
      "import": "./dist/esm/content.js"
    },
    "./dev": {
      "types": "./dist/types/dev.d.ts",
      "import": "./dist/esm/dev.js",
      "require": "./dist/cjs/dev.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "dev:watch": "bun scripts/build-styles.ts && rollup -c -w",
    "build": "bun run clean && bun scripts/build-styles.ts && rollup -c",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke-package.mjs",
    "test:packed": "node scripts/verify-packed-package.mjs",
    "test:bundle": "node scripts/bundle-budget.mjs",
    "visual": "bun scripts/visual-regression.mjs",
    "clean": "rimraf dist",
    "lint": "eslint src scripts/build-styles.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.46.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.4",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-preserve-directives": "1.1.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
