{
  "name": "sherick-ui",
  "version": "1.0.5",
  "description": "A reusable React component library inspired by Material 3 Expressive.",
  "keywords": [
    "react",
    "ui",
    "components",
    "material",
    "design"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "style": "theme.css",
  "type": "module",
  "author": "Sherick Eksteen",
  "files": [
    "dist",
    "tailwind.preset.cjs",
    "theme.css"
  ],
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild"
  ],
  "sideEffects": [
    "./theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./tailwind-preset": "./tailwind.preset.cjs",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "dev": "next dev",
    "next:build": "next build",
    "build": "rollup -c",
    "prebuild": "bun run clean",
    "build:watch": "rollup -c -w",
    "prepare": "bun run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke-package.mjs",
    "verify": "bun run lint && bun run typecheck && bun run build && bun run next:build && bun run test && bun run visual",
    "clean": "rimraf dist",
    "visual": "bun scripts/visual-regression.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": ">=3.4 <4"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^24.13.4",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^5.13.1",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "size-limit": [
    {
      "path": "dist/index.cjs.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/index.esm.js",
      "limit": "10 KB"
    }
  ]
}
